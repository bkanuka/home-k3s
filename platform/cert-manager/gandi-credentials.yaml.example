# Template for gandi-credentials.yaml (git-ignored). Copy, fill in, then seal:
#   platform/sealed-secrets/seal.sh platform/cert-manager/gandi-credentials.yaml
# Name and key are fixed: the webhook chart's RBAC and the ClusterIssuers reference them.
apiVersion: v1
kind: Secret
metadata:
  name: gandi-credentials
  namespace: cert-manager
type: Opaque
stringData:
  pat: REPLACE_WITH_GANDI_PAT  # Gandi Personal Access Token, no trailing whitespace
