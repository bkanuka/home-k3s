# Template for oauth2-proxy-secret.yaml (git-ignored). Copy, fill in, then run
#   platform/sealed-secrets/seal.sh platform/oauth2-proxy/oauth2-proxy-secret.yaml
# and commit the resulting oauth2-proxy-secret-sealed.yaml.
#
# Keys are oauth2-proxy env vars (loaded via envFrom in deployment.yaml):
#   OAUTH2_PROXY_CLIENT_ID / CLIENT_SECRET  the Google OAuth "Web application"
#       client (Google Cloud Console -> APIs & Services -> Credentials) with
#       Authorized redirect URI https://auth.home.bkanuka.com/oauth2/callback.
#       The same client can also serve Argo CD (add its callback URI there; see
#       argocd/argocd-secret.yaml.example).
#   OAUTH2_PROXY_COOKIE_SECRET  32 random bytes, base64url:
#       openssl rand -base64 32 | tr -- '+/' '-_'
#       Rotating it logs everyone out (sessions are encrypted cookies).
apiVersion: v1
kind: Secret
metadata:
  name: oauth2-proxy-secret
  namespace: oauth2-proxy
type: Opaque
stringData:
  OAUTH2_PROXY_CLIENT_ID: REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com
  OAUTH2_PROXY_CLIENT_SECRET: REPLACE_WITH_GOOGLE_CLIENT_SECRET
  OAUTH2_PROXY_COOKIE_SECRET: REPLACE_WITH_32_BYTE_BASE64URL
