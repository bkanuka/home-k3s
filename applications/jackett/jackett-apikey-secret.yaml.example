# Template for jackett-apikey-secret.yaml (git-ignored). Copy, fill in, then run
#   platform/sealed-secrets/seal.sh applications/jackett/jackett-apikey-secret.yaml
# and commit the resulting jackett-apikey-secret-sealed.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: jackett-apikey
  namespace: jackett
type: Opaque
stringData:
  JACKETT_API_KEY: REPLACE_WITH_API_KEY  # Jackett APIKey; spliced into ServerConfig.json at start
