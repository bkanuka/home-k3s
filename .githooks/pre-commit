#!/bin/bash
# pre-commit: refuses to commit plaintext Kubernetes Secrets or private keys.
# Checks the STAGED content of this commit and blocks it if any file is:
#   1. a `kind: Secret` document in a staged *.yaml/*.yml/*.json (parsed with yq;
#      SealedSecret passes, *.yaml.example templates are not scanned)
#   2. a `-----BEGIN ... PRIVATE KEY-----` block in any staged file
# Fails closed: missing yq, unparseable YAML or a git error all block the commit.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass (don't):          git commit --no-verify
set -euo pipefail

PRIVATE_KEY='-----BEGIN( RSA| EC| DSA| OPENSSH| ENCRYPTED| PGP)? PRIVATE KEY'

# The Python "yq" has a different CLI; require mikefarah's v4.
if ! yq --version 2>/dev/null | grep -q mikefarah; then
    echo "✗ pre-commit: mikefarah/yq v4 not found on PATH (needed to parse staged manifests)." >&2
    echo "  Install it: https://github.com/mikefarah/yq#install" >&2
    exit 1
fi

fail=0

# ── 1. plain Secret manifests ────────────────────────────────────────────────
# Reads from the index (`git show :path`) so unstaged edits don't affect the result.
# True if any mapping document (or any item of a `kind: List`) has kind == Secret.
IS_SECRET='[.] | map(select(tag == "!!map")) | map(.kind, .items[]?.kind) | flatten | any_c(. == "Secret")'
plain=()
while IFS= read -r -d '' f; do
    if ! kind_match="$(git show ":$f" | yq ea -r "$IS_SECRET" 2>&1)"; then
        echo "✗ pre-commit: $f: could not parse as YAML: $kind_match" >&2
        exit 1
    fi
    [ "$kind_match" = "true" ] && plain+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.yaml' '*.yml' '*.json')

if [ "${#plain[@]}" -gt 0 ]; then
    echo "✗ pre-commit: plaintext Kubernetes Secret manifest(s) staged:" >&2
    printf '    %s\n' "${plain[@]}" >&2
    echo "  Secrets must be committed as SealedSecrets: keep the plaintext file" >&2
    echo "  git-ignored and commit the output of platform/sealed-secrets/seal.sh <file> instead." >&2
    fail=1
fi

# ── 2. private keys ──────────────────────────────────────────────────────────
# git grep exits 1 for "no match" and >1 for a real error.
rc=0
keys="$(git grep --cached -I -l -E -e "$PRIVATE_KEY")" || rc=$?
if [ "$rc" -gt 1 ]; then
    echo "✗ pre-commit: git grep failed (exit $rc); refusing to commit." >&2
    exit 1
fi
if [ -n "$keys" ]; then
    echo "✗ pre-commit: private key material staged:" >&2
    printf '    %s\n' $keys >&2
    echo "  Never commit private keys (the Sealed Secrets sealing key lives only at" >&2
    echo "  /mnt/main/config/sealed-secrets/master.key on the server and in the" >&2
    echo "  git-ignored platform/sealed-secrets/master.key)." >&2
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo "  Unstage with: git restore --staged <file>" >&2
    exit 1
fi
