PAPERLESS_URL=https://paperless.home.bkanuka.com
PAPERLESS_REDIS=redis://redis.paperless.svc.cluster.local:6379
PAPERLESS_DBHOST=postgres.paperless.svc.cluster.local
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg.paperless.svc.cluster.local:3000
PAPERLESS_TIKA_ENDPOINT=http://tika.paperless.svc.cluster.local:9998
USERMAP_UID=1000
USERMAP_GID=1000
PAPERLESS_TIME_ZONE=America/Toronto
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_MODE=skip
PAPERLESS_OCR_CLEAN=clean-final
PAPERLESS_OCR_ROTATE_PAGES_THRESHOLD=10
PAPERLESS_FILENAME_FORMAT={{ correspondent }}/{{ created_year }}{{ created_month }}{{ created_day }} - {{ title }}
PAPERLESS_TASK_WORKERS=8
PAPERLESS_ENABLE_UPDATE_CHECK=1
PAPERLESS_CONSUMER_RECURSIVE=1
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=1
PAPERLESS_CONSUMER_BARCODE_SCANNER=ZXING
PAPERLESS_DATE_ORDER=MDY
PAPERLESS_CONSUMER_POLLING=2
PAPERLESS_ENABLE_HTTP_REMOTE_USER=true
PAPERLESS_HTTP_REMOTE_USER_HEADER_NAME=HTTP_X_AUTH_REQUEST_EMAIL
