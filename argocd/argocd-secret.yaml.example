# Template for argocd-secret.yaml (git-ignored). Copy, fill in, then run
#   sealed-secrets/seal.sh argocd/argocd-secret.yaml
# and commit the resulting argocd-secret-sealed.yaml.
# GitHub webhook HMAC key; must equal the "Secret" field of the GitHub webhook
# (repo Settings -> Webhooks -> https://argocd.home.bkanuka.com/api/webhook).
# Generate with:  openssl rand -hex 32
#
# PATCH MODE: argocd-secret already exists and is owned by Argo CD (it holds
# server.secretkey, admin.password, tls.*). The patch annotation makes the
# controller ADD only the keys below to the existing Secret instead of replacing
# it, and deleting the SealedSecret never deletes argocd-secret.
apiVersion: v1
kind: Secret
metadata:
  name: argocd-secret
  namespace: argocd
  annotations:
    sealedsecrets.bitnami.com/patch: "true"
type: Opaque
stringData:
  webhook.github.secret: REPLACE_WITH_RANDOM_HEX_32
