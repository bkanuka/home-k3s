# Template for radarr-apikey-secret.yaml (git-ignored). Copy, fill in, then run
#   platform/sealed-secrets/seal.sh applications/radarr/radarr-apikey-secret.yaml
# and commit the resulting radarr-apikey-secret-sealed.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: radarr-apikey
  namespace: radarr
type: Opaque
stringData:
  RADARR_API_KEY: REPLACE_WITH_API_KEY  # Radarr config.xml ApiKey; spliced into config.xml at start
