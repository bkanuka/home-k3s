# Template for pia-credentials.yaml (git-ignored). Copy, fill in, then run
#   platform/sealed-secrets/seal.sh applications/qbittorrent/pia-credentials.yaml
# and commit the resulting pia-credentials-sealed.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: pia-credentials
  namespace: qbittorrent
type: Opaque
stringData:
  PIA_USERNAME: REPLACE_WITH_PIA_USERNAME
  PIA_PASSWORD: REPLACE_WITH_PIA_PASSWORD
