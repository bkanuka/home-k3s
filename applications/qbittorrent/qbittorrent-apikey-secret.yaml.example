# Template for qbittorrent-apikey-secret.yaml (git-ignored). Copy, fill in, then run
#   platform/sealed-secrets/seal.sh applications/qbittorrent/qbittorrent-apikey-secret.yaml
# and commit the resulting qbittorrent-apikey-secret-sealed.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: qbittorrent-apikey
  namespace: qbittorrent
type: Opaque
stringData:
  WEBUI_API_KEY: qbt_REPLACE_WITH_API_KEY  # qBittorrent WebUI\APIKey; spliced into qBittorrent.conf at start
