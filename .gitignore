# Python
.venv/
__pycache__/
*.pyc

# IDE
.idea/

# Helm charts pulled by `kustomize build --enable-helm`
charts/

# Kubeconfigs
*.kubeconfig
kubeconfig
k3s.yaml

# ddns-updater secrets & runtime state
applications/ddns-updater/data/
applications/ddns-updater/config.json

# Plaintext Secret manifests (seal.sh refuses to seal a file that is not ignored here)
*secret*.yaml
*credentials*.yaml
!*-sealed.yaml

# Sealed Secrets sealing (private) key; pub-cert.pem is the public cert and is committed
master.key
*.master.key
