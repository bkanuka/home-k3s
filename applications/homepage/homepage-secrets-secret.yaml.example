# Template for homepage-secrets-secret.yaml (git-ignored). Copy, fill in, then run
#   platform/sealed-secrets/seal.sh applications/homepage/homepage-secrets-secret.yaml
# and commit the resulting homepage-secrets-secret-sealed.yaml. Each value is
# referenced from services.yaml as {{HOMEPAGE_VAR_...}}.
apiVersion: v1
kind: Secret
metadata:
  name: homepage-secrets
  namespace: homepage
type: Opaque
stringData:
  HOMEPAGE_VAR_SONARR_KEY: REPLACE        # Sonarr config.xml ApiKey
  HOMEPAGE_VAR_RADARR_KEY: REPLACE        # Radarr config.xml ApiKey
  HOMEPAGE_VAR_PLEX_TOKEN: REPLACE        # Plex Preferences.xml PlexOnlineToken
  HOMEPAGE_VAR_PAPERLESS_TOKEN: REPLACE   # paperless: manage.py drf_create_token <user>
  HOMEPAGE_VAR_ARGOCD_TOKEN: REPLACE      # argocd account generate-token --account readonly (in the argocd-server pod)
  # Uncomment the matching widgets in services.yaml when adding these:
  # HOMEPAGE_VAR_SEERR_KEY: REPLACE             # Seerr Settings > General > API key
  # HOMEPAGE_VAR_QBITTORRENT_PASSWORD: REPLACE  # qBittorrent WebUI password (user admin)
  # HOMEPAGE_VAR_HA_TOKEN: REPLACE              # Home Assistant long-lived access token
  # HOMEPAGE_VAR_TRUENAS_KEY: REPLACE           # TrueNAS API key
