# Template for frigate-secrets-secret.yaml (git-ignored). Copy, fill in, then run
#   platform/sealed-secrets/seal.sh applications/frigate/frigate-secrets-secret.yaml
# and commit the resulting frigate-secrets-secret-sealed.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: frigate-secrets
  namespace: frigate
type: Opaque
stringData:
  FRIGATE_RTSP_PASSWORD: REPLACE  # cameras' admin password; config.yaml references {FRIGATE_RTSP_PASSWORD}
  FRIGATE_MQTT_PASSWORD: REPLACE  # Home Assistant MQTT user "mqtt"; config.yaml references {FRIGATE_MQTT_PASSWORD}
  PLUS_API_KEY: REPLACE           # Frigate+ (the plus:// model in config.yaml)
