# Template for sonarr-apikey-secret.yaml (git-ignored). Copy, fill in, then run
#   platform/sealed-secrets/seal.sh applications/sonarr/sonarr-apikey-secret.yaml
# and commit the resulting sonarr-apikey-secret-sealed.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: sonarr-apikey
  namespace: sonarr
type: Opaque
stringData:
  SONARR_API_KEY: REPLACE_WITH_API_KEY  # Sonarr config.xml ApiKey; spliced into config.xml at start
