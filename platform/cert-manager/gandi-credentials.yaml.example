# Template for gandi-credentials.yaml (git-ignored). Copy, fill in, then run
#   platform/sealed-secrets/seal.sh platform/cert-manager/gandi-credentials.yaml
# and commit the resulting gandi-credentials-sealed.yaml.
# Gandi Personal Access Token for the cert-manager DNS-01 webhook. Name/key are
# fixed (the chart RBAC + ClusterIssuers reference them). No trailing whitespace
# in the value — it goes straight into an "Authorization: Bearer <PAT>" header.
apiVersion: v1
kind: Secret
metadata:
  name: gandi-credentials
  namespace: cert-manager
type: Opaque
stringData:
  pat: REPLACE_WITH_GANDI_PAT
