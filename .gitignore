# Python virtualenv
.venv/
__pycache__/
*.pyc

# IDE
.idea/

# Helm charts pulled on demand by `kustomize build --enable-helm` (platform/*)
charts/

# Kubeconfig / secrets (never commit)
*.kubeconfig
kubeconfig
k3s.yaml

# ddns-updater secrets & runtime state (only the .example belongs in git)
applications/ddns-updater/data/
applications/ddns-updater/config.json

# Plaintext Secret manifests sit next to their <name>-sealed.yaml output in each
# app dir (templates: <name>.yaml.example) and must never be committed. They are
# ignored by file name — anything with "secret" or "credentials" in it that is
# not the -sealed output. sealed-secrets/seal.sh refuses to seal a file that is
# not ignored, and .githooks/pre-commit is the backstop.
*secret*.yaml
*credentials*.yaml
!*-sealed.yaml

# Sealed Secrets sealing key — NEVER commit (this is the PRIVATE key that
# decrypts every SealedSecret). The server keeps it at
# /mnt/main/config/sealed-secrets/master.key; the off-box copy lives in the
# working tree at platform/sealed-secrets/master.key (see its README). Note:
# platform/sealed-secrets/pub-cert.pem is the PUBLIC cert and IS committed (safe).
master.key
*.master.key
